---
import { timeline } from '../data/site';

interface Props {
  items: typeof timeline;
}

const { items } = Astro.props;
---

<div class="timeline">
  {
    items.map((item, index) => (
      <div class={`timeline-item${index === 0 ? ' timeline-item--active' : ''}`}>
        <p class="kicker">{item.period}</p>
        <h3>{item.role}</h3>
        <p class="kicker">
          {item.company}
          {item.location && <span aria-hidden="true"> &middot; </span>}
          {item.location}
        </p>
        <p>{item.summary}</p>
      </div>
    ))
  }
</div>

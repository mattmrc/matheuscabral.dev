---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { data } = project;
---

<BaseLayout title={`${data.title} - ${site.name}`} description={data.description}>
  <section class="section">
    <div class="container">
      <a href="/portfolio" class="back-link">&larr; All projects</a>
      <p class="eyebrow">Project</p>
      <h1 class="headline reveal">{data.title}</h1>
      <p class="subhead reveal reveal-delay-1">{data.description}</p>
      <div class="tag-list detail-tags">
        {data.tags.map((tag) => <Badge label={tag} />)}
      </div>
      <div class="tag-list detail-stack">
        {data.stack.map((item) => <span class="kicker">{item}</span>)}
      </div>
      <div class="detail-actions">
        {
          data.links?.caseStudy && (
            <Button href={data.links.caseStudy} variant="outline">
              Read case study
            </Button>
          )
        }
        {
          data.links?.demo && (
            <Button href={data.links.demo} variant="ghost">
              Live demo
            </Button>
          )
        }
        {
          data.links?.repo && (
            <Button href={data.links.repo} variant="ghost">
              Repository
            </Button>
          )
        }
      </div>
      {
        data.highlights?.length && (
          <div class="surface detail-highlights">
            <h2 class="surface__title">Highlights</h2>
            <ul>
              {data.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container">
      <div class="surface prose prose--full">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

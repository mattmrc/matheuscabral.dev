---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
---

<BaseLayout title={`Page not found - ${site.name}`} noFooter>
  <section class="section" style="min-height: 60vh; display: grid; place-items: center;">
    <div class="container" style="text-align: center;">
      <p class="eyebrow">404</p>
      <h1 class="headline reveal">Page not found</h1>
      <p class="subhead reveal reveal-delay-1" style="margin: 0 auto var(--space-5);">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="reveal reveal-delay-2" style="display: flex; gap: var(--space-3); justify-content: center;">
        <Button href="/">Back to home</Button>
        <Button href="/contact" variant="outline">Get in touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
